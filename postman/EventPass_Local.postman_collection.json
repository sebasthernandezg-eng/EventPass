{
  "info": {
    "name": "EventPass - Pruebas locales",
    "description": "Pruebas API e integración. Importa solo esta colección; baseUrl y variables de flujo están incluidas. Ejecutar el orden sugerido con Compose activo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "demoPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "buyerUsername",
      "value": "",
      "type": "string"
    },
    {
      "key": "staffUsername",
      "value": "",
      "type": "string"
    },
    {
      "key": "buyerId",
      "value": "",
      "type": "string"
    },
    {
      "key": "staffId",
      "value": "",
      "type": "string"
    },
    {
      "key": "buyerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "staffToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "eventDate",
      "value": "",
      "type": "string"
    },
    {
      "key": "eventId",
      "value": "",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "pollCount",
      "value": "0",
      "type": "string"
    },
    {
      "key": "ticketCode",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1 - Autenticación",
      "item": [
        {
          "name": "Registrar comprador de prueba",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('buyerUsername', 'buyer_' + Date.now());",
                  "pm.collectionVariables.set('demoPassword', 'ClaveDemo123');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201 Created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set('buyerId', String(pm.response.json().id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{buyerUsername}}\",\n  \"password\": \"{{demoPassword}}\",\n  \"role\": \"BUYER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "response": []
        },
        {
          "name": "Registrar staff de prueba",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('staffUsername', 'staff_' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201 Created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set('staffId', String(pm.response.json().id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{staffUsername}}\",\n  \"password\": \"{{demoPassword}}\",\n  \"role\": \"STAFF\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "response": []
        },
        {
          "name": "Iniciar sesión como staff",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('Entrega token de rol STAFF', () => { pm.expect(data.token).to.be.a('string'); pm.expect(data.role).to.eql('STAFF'); });",
                  "pm.collectionVariables.set('staffToken', data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{staffUsername}}\",\n  \"password\": \"{{demoPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "response": []
        },
        {
          "name": "Iniciar sesión como comprador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('Entrega token de rol BUYER', () => { pm.expect(data.token).to.be.a('string'); pm.expect(data.role).to.eql('BUYER'); });",
                  "pm.collectionVariables.set('buyerToken', data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{buyerUsername}}\",\n  \"password\": \"{{demoPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "response": []
        }
      ]
    },
    {
      "name": "2 - Eventos",
      "item": [
        {
          "name": "Crear evento de prueba (STAFF)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000);",
                  "const pad = n => String(n).padStart(2, '0');",
                  "pm.collectionVariables.set('eventDate', `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T20:00:00`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201 Created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { const data = pm.response.json(); pm.collectionVariables.set('eventId', String(data.id)); pm.test('Aforo disponible coincide con el inicial', () => pm.expect(data.available).to.eql(data.capacity)); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{staffToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Concierto EventPass Postman\",\n  \"location\": \"Auditorio de prueba\",\n  \"eventDate\": \"{{eventDate}}\",\n  \"capacity\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/events"
          },
          "response": []
        },
        {
          "name": "Listar eventos (BUYER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 OK', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test('La respuesta es una lista', () => pm.expect(list).to.be.an('array'));",
                  "pm.test('Incluye el evento creado', () => pm.expect(list.some(e => String(e.id) === pm.collectionVariables.get('eventId'))).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{buyerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/events"
          },
          "response": []
        },
        {
          "name": "Intentar crear evento con BUYER (debe dar 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('BUYER no puede crear eventos', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{buyerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"No autorizado\",\n  \"location\": \"Auditorio\",\n  \"eventDate\": \"{{eventDate}}\",\n  \"capacity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/events"
          },
          "response": []
        },
        {
          "name": "Actualizar evento (STAFF)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Mantiene el aforo disponible', () => pm.expect(pm.response.json().available).to.eql(5));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{staffToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Concierto EventPass actualizado\",\n  \"location\": \"Auditorio de prueba\",\n  \"eventDate\": \"{{eventDate}}\",\n  \"capacity\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/events/{{eventId}}"
          },
          "response": []
        }
      ]
    },
    {
      "name": "3 - Órdenes y procesamiento asíncrono",
      "item": [
        {
          "name": "Crear orden (BUYER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 202 Accepted', () => pm.response.to.have.status(202));",
                  "const order = pm.response.json();",
                  "pm.collectionVariables.set('orderId', String(order.id));",
                  "pm.collectionVariables.set('pollCount', '0');",
                  "pm.test('Orden comienza pendiente', () => pm.expect(order.status).to.eql('ACEPTADA_PENDIENTE'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{buyerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": {{eventId}},\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/orders"
          },
          "response": []
        },
        {
          "name": "Consultar estado orden",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 OK', () => pm.response.to.have.status(200));",
                  "const order = pm.response.json();",
                  "let count = Number(pm.collectionVariables.get('pollCount') || '0');",
                  "if (order.status === 'ACEPTADA_PENDIENTE' && count < 15) { pm.collectionVariables.set('pollCount', String(count + 1)); pm.execution.setNextRequest('Consultar estado orden'); } else { pm.collectionVariables.set('pollCount', '0'); pm.test('La orden se procesó y emitió', () => pm.expect(order.status).to.eql('EMITIDA')); pm.execution.setNextRequest('Consultar mis tickets'); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{buyerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/orders/{{orderId}}"
          },
          "response": []
        }
      ]
    },
    {
      "name": "4 - Tickets",
      "item": [
        {
          "name": "Consultar mis tickets",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 OK', () => pm.response.to.have.status(200));",
                  "const tickets = pm.response.json();",
                  "pm.test('Existe al menos un ticket', () => pm.expect(tickets.length).to.be.above(0));",
                  "if (tickets.length > 0) pm.collectionVariables.set('ticketCode', tickets[0].accessCode);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{buyerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/tickets/mine"
          },
          "response": []
        },
        {
          "name": "Validar ticket primera vez (STAFF)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Primera validación responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Autoriza ingreso', () => pm.expect(pm.response.json().valid).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{staffToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/tickets/validate/{{ticketCode}}"
          },
          "response": []
        },
        {
          "name": "Reutilizar ticket (debe dar 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Ticket ya usado responde 409 Conflict', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{staffToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/tickets/validate/{{ticketCode}}"
          },
          "response": []
        }
      ]
    }
  ]
}
